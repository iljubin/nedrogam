---
import '../styles/global.css';

const {
  title = 'Ne, drogam',
  description = 'Znanje, pogovor in podpora za varnejše odločitve.',
  lang = 'sl',
  ogLocale = 'sl_SI',
  languageAlternates = [],
} = Astro.props;
const isSerbian = lang === 'sr-Cyrl';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {languageAlternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.path, Astro.site)} />)}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f8f8f3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=5" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=5" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=5" />
    <title>{title} · Ne, drogam</title>
  </head>
  <body>
    <a class="skip" href="#main">{isSerbian ? 'Пређи на главни садржај' : 'Preskoči na glavno vsebino'}</a>
    <header class="border-b border-[var(--line)]">
      <div class="wrap flex min-h-[82px] items-center justify-between gap-6">
        <a href="/" class="flex h-[50px] w-[162px] shrink-0 items-center no-underline sm:h-[58px] sm:w-[190px]" style="text-decoration:none" aria-label={isSerbian ? 'Ne, drogam – почетна страница' : 'Ne, drogam – domača stran'}>
          <img src="/logo-ne-drogam.svg?v=6" width="190" height="58" alt="" class="h-[50px] w-[162px] sm:h-[58px] sm:w-[190px]" />
        </a>
        <nav aria-label={isSerbian ? 'Главна навигација' : 'Glavna navigacija'} class="hidden flex-wrap items-center gap-5 text-sm font-semibold md:flex">
          <a href="/">{isSerbian ? 'Почетна' : 'Domov'}</a>
          <a href="/o-zavodu/">{isSerbian ? 'О нама' : 'O nas'}</a>
          <a href="/preventiva/">{isSerbian ? 'Превенција' : 'Preventiva'}</a>
          <a href="/prispevki/">{isSerbian ? 'Чланци' : 'Prispevki'}</a>
          <a href="/sodelovanje/">{isSerbian ? 'Сарадња' : 'Sodelovanje'}</a>
        </nav>
        <a class="btn !px-4 !py-2.5 text-sm" href="/kontakt/">{isSerbian ? 'Контакт' : 'Kontakt'}</a>
      </div>
      <nav aria-label={isSerbian ? 'Навигација за мобилне уређаје' : 'Navigacija za mobilne naprave'} class="wrap flex gap-4 overflow-x-auto pb-3 text-xs font-semibold md:hidden">
        <a href="/">{isSerbian ? 'Почетна' : 'Domov'}</a>
        <a href="/o-zavodu/">{isSerbian ? 'О нама' : 'O nas'}</a>
        <a href="/preventiva/">{isSerbian ? 'Превенција' : 'Preventiva'}</a>
        <a href="/prispevki/">{isSerbian ? 'Чланци' : 'Prispevki'}</a>
        <a href="/sodelovanje/">{isSerbian ? 'Сарадња' : 'Sodelovanje'}</a>
        <a href="/kontakt/">{isSerbian ? 'Контакт' : 'Kontakt'}</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="border-t border-[var(--line)] bg-white py-10">
      <div class="wrap grid gap-8 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <strong class="text-lg">Ne, drogam</strong>
          <p class="muted max-w-sm">{isSerbian ? 'За безбедније одрастање и информисане одлуке засноване на поузданим информацијама.' : 'Za varnejše odraščanje in informirane odločitve na podlagi zanesljivih informacij.'}</p>
          <small class="muted">{isSerbian ? 'Завод је независна организација. Садржај не представља званичан став државних установа.' : 'Neodvisen zavod. Vsebina ne predstavlja uradnega stališča državnih ustanov.'}</small>
        </div>
        <div>
          <strong>{isSerbian ? 'Истражите' : 'Raziščite'}</strong>
          <div class="mt-3 grid gap-2 text-sm">
            <a href="/preventiva/">{isSerbian ? 'Превенција' : 'Preventiva'}</a>
            <a href="/prispevki/">{isSerbian ? 'Чланци' : 'Prispevki'}</a>
            <a href="/sodelovanje/">{isSerbian ? 'Сарадња' : 'Sodelovanje'}</a>
            <a href="/dlaka/">{isSerbian ? 'Подржана иницијатива: Длака' : 'Podprta pobuda: Dlaka'}</a>
          </div>
        </div>
        <div>
          <strong>{isSerbian ? 'Контакт' : 'Kontakt'}</strong>
          <p class="muted">Reboljeva ulica 10<br />1000 Ljubljana</p>
          <a href="mailto:kontakt@nedrogam.org">kontakt@nedrogam.org</a>
        </div>
      </div>
      <div class="wrap mt-8 border-t border-[var(--line)] pt-5 text-xs muted">© {new Date().getFullYear()} Zavod za preventivo uporabe drog – Ne, drogam</div>
    </footer>
  </body>
</html>
