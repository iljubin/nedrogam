---
import { Image } from 'astro:assets';
import type { TheatreProduction } from '../data/theatre';
import { dlakaLocaleContent, type DlakaLocale } from '../i18n/dlaka';

const { production, locale = 'sl' } = Astro.props as { production: TheatreProduction; locale?: DlakaLocale };
const sr = locale === 'sr-Cyrl';
const dialogId = `dlaka-photo-lightbox-${locale}`;
const t = dlakaLocaleContent(locale);
const timestampFromFilename = (filename: string) => {
  const match = filename.match(/(\d{4}-\d{2}-\d{2})_(\d{2}-\d{2}-\d{2})/);
  if (!match) throw new Error(`Media filename does not contain a sortable timestamp: ${filename}`);
  return `${match[1]}T${match[2].replaceAll('-', ':')}`;
};
const media = [...production.media].sort((a, b) => {
  const byTimestamp = timestampFromFilename(a.filename).localeCompare(timestampFromFilename(b.filename));
  return byTimestamp || a.filename.localeCompare(b.filename);
});
let photoIndex = 0;
---
{media.length > 0 && <section class="mt-8" aria-label={t.mediaGalleryLabel}><h3 class="serif text-2xl">{t.mediaGallery}</h3><div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">{media.map((item) => { const alt = sr ? item.srCyrlAlt : item.alt; if (item.type === 'photo') { const index = photoIndex++; return <figure class="m-0 overflow-hidden rounded-2xl border border-[var(--line)] bg-white"><a class="dlaka-gallery-trigger block cursor-zoom-in focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-[var(--green)]" href={item.src.src} target="_blank" rel="noopener" data-gallery-index={index} aria-label={`${t.enlargePhoto}: ${alt}`}><Image src={item.src} alt={alt} class="block h-auto w-full" widths={[480, 800, 1280]} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" loading="lazy"/></a><figcaption class="p-4 text-sm muted">{alt}</figcaption></figure>; } return <figure class="m-0 overflow-hidden rounded-2xl border border-[var(--line)] bg-white"><video class="block h-auto w-full" controls preload="metadata" playsinline poster={item.poster} aria-label={`${t.videoLabel}: ${alt}`}><source src={item.src} type="video/mp4"/>{t.videoFallback}</video><figcaption class="p-4 text-sm muted">{item.caption[locale]}</figcaption></figure>; })}</div>
  <dialog id={dialogId} class="dlaka-lightbox fixed inset-0 m-0 h-full max-h-none w-full max-w-none border-0 bg-transparent p-0 text-white backdrop:bg-black/85" aria-label={t.lightboxDialog}>
    <div class="relative grid h-full w-full place-items-center p-4 sm:p-8">
      <button type="button" class="dlaka-lightbox-close absolute right-4 top-4 z-10 rounded-full bg-black/65 px-4 py-3 font-semibold text-white hover:bg-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" aria-label={t.closeLightbox}>×</button>
      <button type="button" class="dlaka-lightbox-prev absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-black/65 px-4 py-3 text-2xl text-white hover:bg-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:left-6" aria-label={t.previousPhoto}>‹</button>
      <img class="dlaka-lightbox-image max-h-full max-w-full object-contain" alt="" />
      <button type="button" class="dlaka-lightbox-next absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-black/65 px-4 py-3 text-2xl text-white hover:bg-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:right-6" aria-label={t.nextPhoto}>›</button>
    </div>
  </dialog>
</section>}

<script>
  document.querySelectorAll<HTMLDialogElement>('.dlaka-lightbox').forEach((dialog) => {
    const triggers = Array.from(document.querySelectorAll<HTMLAnchorElement>('.dlaka-gallery-trigger'));
    const image = dialog.querySelector<HTMLImageElement>('.dlaka-lightbox-image');
    const closeButton = dialog.querySelector<HTMLButtonElement>('.dlaka-lightbox-close');
    const previousButton = dialog.querySelector<HTMLButtonElement>('.dlaka-lightbox-prev');
    const nextButton = dialog.querySelector<HTMLButtonElement>('.dlaka-lightbox-next');
    if (!image || !closeButton || !previousButton || !nextButton || triggers.length === 0) return;

    let activeIndex = 0;
    let opener: HTMLAnchorElement | null = null;
    let oldOverflow = '';
    let touchStartX: number | null = null;

    const showImage = (index: number) => {
      activeIndex = (index + triggers.length) % triggers.length;
      const trigger = triggers[activeIndex];
      const thumbnail = trigger.querySelector('img');
      image.src = trigger.href;
      image.alt = thumbnail?.alt ?? '';
    };

    triggers.forEach((trigger, index) => trigger.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      opener = trigger;
      showImage(index);
      oldOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      dialog.showModal();
      closeButton.focus();
    }));

    closeButton.addEventListener('click', () => dialog.close());
    previousButton.addEventListener('click', () => showImage(activeIndex - 1));
    nextButton.addEventListener('click', () => showImage(activeIndex + 1));
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); showImage(activeIndex - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); showImage(activeIndex + 1); }
    });
    dialog.addEventListener('touchstart', (event) => { touchStartX = event.changedTouches[0]?.clientX ?? null; }, { passive: true });
    dialog.addEventListener('touchend', (event) => {
      if (touchStartX === null) return;
      const delta = (event.changedTouches[0]?.clientX ?? touchStartX) - touchStartX;
      if (Math.abs(delta) > 45) showImage(activeIndex + (delta < 0 ? 1 : -1));
      touchStartX = null;
    }, { passive: true });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = oldOverflow;
      opener?.focus();
      opener = null;
    });
  });
</script>

<style>
  .dlaka-lightbox[open] { display: block; }
  .dlaka-lightbox-image { width: auto; height: auto; }
  .dlaka-lightbox button { min-width: 2.75rem; min-height: 2.75rem; }
</style>
